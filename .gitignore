__pycache__/
*.pyc
*.zip

# Öğrencinin cihazında oluşan kayıtlar ve karneler: asla depoya girmez.
kayitlar/

# Her bilgisayarda yeniden üretilen dosyalar
tools/.sesler/
.ses-ortami/
.dizin/
.modeller/
lessons/*/audio/

# ÖZEL İÇERİK: kendi notlarınızı, vakalarınızı ve hasta görsellerinizi buraya koyun.
# Bu klasördeki hiçbir şey açık depoya yüklenmez (bkz. belgeler/ozel-icerik.md).
ozel/
# Adı "ozel-" ile başlayan dersler ve vaka kartları da hiçbir zaman depoya girmez:
#   lessons/ozel-akut-lezyonlar/      (fakülteye özel ders)
#   lessons/<ders>/vakalar/ozel-*     (gerçek hastadan uyarlanmış vaka ve görselleri)
lessons/ozel-*/
lessons/*/vakalar/ozel-*

# Ders videoları (lessons/<ders>/videolar/): büyük ve çoğu zaman telifli; hiçbir zaman depoya girmez.
# Herkese açık bir video için ders dosyasında YouTube bağlantısı kullanın.
lessons/*/videolar/
*.mp4
*.m4v
*.webm
*.ogv
*.mov

# Makale bulucunun öğrenci bilgisayarında ürettiği makale metinleri ve yarım kalmış ders kurulumları.
# Makaleler abonelikli olabilir: metinleri hiçbir zaman depoya ya da ders paketine girmez.
lessons/*/makale-metin/
lessons/.kur-*/
lessons/*.eski/
